<Window x:Class="FieldKit.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FieldKit"
        Width="1120" Height="760"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Icon="fieldkit.ico">

    <Grid Background="{StaticResource Fk.Bg.Window}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="196"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- NAVIGATION RAIL -->
        <Border Grid.Column="0" Background="{StaticResource Fk.Bg.Rail}"
                BorderBrush="{StaticResource Fk.Border}" BorderThickness="0,0,1,0">
            <DockPanel Margin="10,16,10,12">
                <StackPanel DockPanel.Dock="Top" Margin="10,0,0,18">
                    <TextBlock Text="FieldKit" FontSize="17" FontWeight="SemiBold"
                               Foreground="{StaticResource Fk.Text.Primary}"/>
                    <TextBlock x:Name="VersionText" Style="{StaticResource Fk.Secondary}"
                               Foreground="{StaticResource Fk.Text.Muted}"/>
                </StackPanel>

                <Button DockPanel.Dock="Bottom" Content="Open kit folder"
                        Style="{StaticResource Fk.Button}" Click="OpenKitFolder_Click"/>

                <StackPanel>
                    <RadioButton x:Name="NavMaintain" Content="Maintain" GroupName="Nav"
                                 Style="{StaticResource Fk.NavItem}" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavApps" Content="Apps" GroupName="Nav"
                                 Style="{StaticResource Fk.NavItem}" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavKit" Content="Support kit" GroupName="Nav"
                                 Style="{StaticResource Fk.NavItem}" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavReports" Content="Reports" GroupName="Nav"
                                 Style="{StaticResource Fk.NavItem}" Checked="Nav_Checked"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- PAGE + ACTIVITY -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="260"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="150" MinHeight="70"/>
            </Grid.RowDefinitions>

            <Border x:Name="AccountNotice" Grid.Row="0" Style="{StaticResource Fk.Notice}"
                    Margin="20,14,20,0" Visibility="Collapsed">
                <TextBlock x:Name="AccountNoticeText" TextWrapping="Wrap" FontSize="12.5"/>
            </Border>

            <ContentControl x:Name="PageHost" Grid.Row="1" Margin="20,16,20,10" Focusable="False"/>

            <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch"
                          Background="{StaticResource Fk.Border}" ResizeDirection="Rows"/>

            <!-- ACTIVITY LOG: shared by every page -->
            <Grid Grid.Row="3" Background="{StaticResource Fk.Bg.Log}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="20,8,20,4">
                    <Button DockPanel.Dock="Right" Content="Open log" Padding="10,3" MinHeight="24"
                            FontSize="12" Style="{StaticResource Fk.Button}" Click="OpenLog_Click"/>
                    <TextBlock Text="Activity" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                               Foreground="{StaticResource Fk.Text.Muted}"/>
                    <TextBlock x:Name="BusyText" Style="{StaticResource Fk.Secondary}"
                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                </DockPanel>
                <ListBox x:Name="LogList" Grid.Row="1" Margin="14,0,6,6"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Focusable" Value="False"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter Margin="6,0"/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock x:Name="Line" Text="{Binding Text}" FontSize="12"
                                       FontFamily="{StaticResource Fk.Font.Mono}"
                                       Foreground="{StaticResource Fk.Text.Secondary}"/>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Level}" Value="OK">
                                    <Setter TargetName="Line" Property="Foreground" Value="{StaticResource Fk.Ok.Text}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Level}" Value="WARN">
                                    <Setter TargetName="Line" Property="Foreground" Value="{StaticResource Fk.Warn.Text}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Level}" Value="ERROR">
                                    <Setter TargetName="Line" Property="Foreground" Value="{StaticResource Fk.Error.Text}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="LogPlaceholder" Grid.Row="1" Margin="20,4,0,0"
                           Text="Output appears here when something runs."
                           Style="{StaticResource Fk.Secondary}"
                           Foreground="{StaticResource Fk.Text.Muted}"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
