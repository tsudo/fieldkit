<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Every colour in the app is defined here. No other XAML file sets a hex value. -->

    <!-- Surfaces -->
    <SolidColorBrush x:Key="Fk.Bg.Window" Color="#202020"/>
    <SolidColorBrush x:Key="Fk.Bg.Rail" Color="#191919"/>
    <SolidColorBrush x:Key="Fk.Bg.Card" Color="#2A2A2A"/>
    <SolidColorBrush x:Key="Fk.Bg.Hover" Color="#343434"/>
    <SolidColorBrush x:Key="Fk.Bg.Pressed" Color="#3D3D3D"/>
    <SolidColorBrush x:Key="Fk.Bg.Log" Color="#181818"/>
    <SolidColorBrush x:Key="Fk.Border" Color="#3A3A3A"/>

    <!-- Text -->
    <SolidColorBrush x:Key="Fk.Text.Primary" Color="#F2F2F2"/>
    <SolidColorBrush x:Key="Fk.Text.Secondary" Color="#B8B8B8"/>
    <SolidColorBrush x:Key="Fk.Text.Muted" Color="#8C8C8C"/>
    <SolidColorBrush x:Key="Fk.Text.OnAccent" Color="#0B0B0B"/>

    <!-- Status: pill background and text for each state -->
    <SolidColorBrush x:Key="Fk.Ok.Bg" Color="#1E3B2A"/>
    <SolidColorBrush x:Key="Fk.Ok.Text" Color="#84D6A0"/>
    <SolidColorBrush x:Key="Fk.Warn.Bg" Color="#45370F"/>
    <SolidColorBrush x:Key="Fk.Warn.Text" Color="#F0C460"/>
    <SolidColorBrush x:Key="Fk.Error.Bg" Color="#4A1E1E"/>
    <SolidColorBrush x:Key="Fk.Error.Text" Color="#F29C9C"/>
    <SolidColorBrush x:Key="Fk.Info.Bg" Color="#1D3350"/>
    <SolidColorBrush x:Key="Fk.Info.Text" Color="#93C5F7"/>
    <SolidColorBrush x:Key="Fk.Neutral.Bg" Color="#363636"/>

    <FontFamily x:Key="Fk.Font.Mono">Cascadia Mono, Consolas</FontFamily>

    <!-- Text styles -->
    <Style x:Key="Fk.PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Fk.Text.Primary}"/>
    </Style>
    <Style x:Key="Fk.PageSubtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource Fk.Text.Secondary}"/>
        <Setter Property="Margin" Value="0,2,0,14"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Fk.GroupLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Fk.Text.Muted}"/>
        <Setter Property="Margin" Value="2,14,0,4"/>
    </Style>
    <Style x:Key="Fk.Secondary" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource Fk.Text.Secondary}"/>
    </Style>

    <!-- Buttons -->
    <Style x:Key="Fk.Button" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Fk.Text.Primary}"/>
        <Setter Property="Background" Value="{StaticResource Fk.Bg.Card}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Fk.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="5" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Fk.Bg.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Fk.Bg.Pressed}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Fk.Text.Secondary}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Fk.Button.Primary" TargetType="Button" BasedOn="{StaticResource Fk.Button}">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Fk.Text.OnAccent}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{DynamicResource {x:Static SystemColors.AccentColorLight2BrushKey}}"
                            CornerRadius="5" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource {x:Static SystemColors.AccentColorLight1BrushKey}}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Fk.Text.Primary}"/>
                            <Setter TargetName="Bd" Property="BorderThickness" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Navigation rail item -->
    <Style x:Key="Fk.NavItem" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource Fk.Text.Secondary}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Padding="10,9">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="Mark" Width="3" Height="16" CornerRadius="1.5"
                                    Background="Transparent" Margin="0,0,10,0"/>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Fk.Bg.Card}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Fk.Bg.Hover}"/>
                            <Setter TargetName="Mark" Property="Background"
                                    Value="{DynamicResource {x:Static SystemColors.AccentColorLight2BrushKey}}"/>
                            <Setter Property="Foreground" Value="{StaticResource Fk.Text.Primary}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Fk.Text.Secondary}"/>
                            <Setter TargetName="Bd" Property="BorderThickness" Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Preset / bundle chip -->
    <Style x:Key="Fk.Chip" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource Fk.Text.Primary}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="{StaticResource Fk.Bg.Card}"
                            BorderBrush="{StaticResource Fk.Border}" BorderThickness="1"
                            CornerRadius="14" Padding="13,5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Fk.Bg.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Fk.Info.Bg}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Fk.Info.Text}"/>
                            <Setter Property="Foreground" Value="{StaticResource Fk.Info.Text}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Fk.Text.Secondary}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Checklist row container -->
    <Style x:Key="Fk.Row" TargetType="Border">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{StaticResource Fk.Border}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="6,8"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Fk.Bg.Card}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Status pill. Tag carries the tone: Ok, Warn, Error, Info, or anything else for neutral. -->
    <Style x:Key="Fk.Pill" TargetType="Border">
        <Setter Property="CornerRadius" Value="9"/>
        <Setter Property="Padding" Value="9,2"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Background" Value="{StaticResource Fk.Neutral.Bg}"/>
        <Setter Property="TextElement.Foreground" Value="{StaticResource Fk.Text.Secondary}"/>
        <Setter Property="TextElement.FontSize" Value="11.5"/>
        <Style.Triggers>
            <Trigger Property="Tag" Value="Ok">
                <Setter Property="Background" Value="{StaticResource Fk.Ok.Bg}"/>
                <Setter Property="TextElement.Foreground" Value="{StaticResource Fk.Ok.Text}"/>
            </Trigger>
            <Trigger Property="Tag" Value="Warn">
                <Setter Property="Background" Value="{StaticResource Fk.Warn.Bg}"/>
                <Setter Property="TextElement.Foreground" Value="{StaticResource Fk.Warn.Text}"/>
            </Trigger>
            <Trigger Property="Tag" Value="Error">
                <Setter Property="Background" Value="{StaticResource Fk.Error.Bg}"/>
                <Setter Property="TextElement.Foreground" Value="{StaticResource Fk.Error.Text}"/>
            </Trigger>
            <Trigger Property="Tag" Value="Info">
                <Setter Property="Background" Value="{StaticResource Fk.Info.Bg}"/>
                <Setter Property="TextElement.Foreground" Value="{StaticResource Fk.Info.Text}"/>
            </Trigger>
            <Trigger Property="Tag" Value="">
                <Setter Property="Visibility" Value="Collapsed"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Notice bar -->
    <Style x:Key="Fk.Notice" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Fk.Warn.Bg}"/>
        <Setter Property="CornerRadius" Value="5"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="TextElement.Foreground" Value="{StaticResource Fk.Warn.Text}"/>
    </Style>

    <BooleanToVisibilityConverter x:Key="BoolToVis"/>

    <!-- Text that collapses when it has nothing to show -->
    <Style x:Key="Fk.RowDetail" TargetType="TextBlock" BasedOn="{StaticResource Fk.Secondary}">
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,1,0,0"/>
        <Style.Triggers>
            <Trigger Property="Text" Value="">
                <Setter Property="Visibility" Value="Collapsed"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- One checklist row, bound to a RowViewModel. Used by every page. -->
    <DataTemplate x:Key="Fk.RowTemplate">
        <Border Style="{StaticResource Fk.Row}"
                Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                          IsEnabled="{Binding CanSelect}"
                          VerticalContentAlignment="Center" Padding="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding Name}" FontSize="13.5"
                                   Foreground="{StaticResource Fk.Text.Primary}"/>
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Fk.RowDetail}"/>
                    </StackPanel>
                </CheckBox>
                <TextBlock Grid.Column="1" Text="{Binding Meta}" Style="{StaticResource Fk.Secondary}"
                           VerticalAlignment="Center" Margin="16,0,12,0"/>
                <Border Grid.Column="2" Style="{StaticResource Fk.Pill}" Tag="{Binding PillTone}" MinWidth="64">
                    <TextBlock Text="{Binding PillText}" HorizontalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- A labelled group of rows, bound to a GroupViewModel. -->
    <DataTemplate x:Key="Fk.GroupTemplate">
        <StackPanel Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding Name}" Style="{StaticResource Fk.GroupLabel}"/>
            <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource Fk.RowTemplate}"
                          Focusable="False"/>
        </StackPanel>
    </DataTemplate>

    <!-- Card for summaries and empty states -->
    <Style x:Key="Fk.Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Fk.Bg.Card}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Fk.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="14,10"/>
    </Style>

    <!-- Bottom action bar on each page -->
    <Style x:Key="Fk.ActionBar" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource Fk.Border}"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
        <Setter Property="Padding" Value="0,12,0,0"/>
        <Setter Property="Margin" Value="0,8,0,0"/>
    </Style>
</ResourceDictionary>
