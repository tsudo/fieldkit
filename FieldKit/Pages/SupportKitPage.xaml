<UserControl x:Class="FieldKit.Pages.SupportKitPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Support kit" Style="{StaticResource Fk.PageTitle}"/>
            <TextBlock Text="Stages troubleshooting tools and a snapshot of this PC in one folder."
                       Style="{StaticResource Fk.PageSubtitle}"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Fk.Card}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Open folder" Padding="10,3" MinHeight="26" FontSize="12"
                        Style="{StaticResource Fk.Button}" Click="OpenFolder_Click"/>
                <StackPanel>
                    <TextBlock x:Name="FolderText" FontFamily="{StaticResource Fk.Font.Mono}" FontSize="12.5"
                               Foreground="{StaticResource Fk.Text.Primary}"/>
                    <TextBlock Style="{StaticResource Fk.RowDetail}"
                               Text="Tools are downloaded from Microsoft when you build the kit and checked for a Microsoft signature. Each tool shows its own licence the first time it runs."/>
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Focusable="False" Margin="0,2,0,0">
            <ItemsControl x:Name="GroupList" ItemTemplate="{StaticResource Fk.GroupTemplate}"
                          Focusable="False" Margin="0,0,10,0"/>
        </ScrollViewer>

        <Border Grid.Row="3" Style="{StaticResource Fk.ActionBar}">
            <DockPanel>
                <Button x:Name="BuildButton" Content="Build kit" Style="{StaticResource Fk.Button.Primary}"
                        MinWidth="130" Click="Build_Click"/>
                <Button x:Name="StopButton" Content="Stop" Style="{StaticResource Fk.Button}"
                        Margin="8,0,0,0" Visibility="Collapsed" Click="Stop_Click"/>
                <Button x:Name="ZipButton" Content="Zip for sharing" Style="{StaticResource Fk.Button}"
                        Margin="8,0,0,0" Click="Zip_Click"
                        ToolTip="Zips the reports and logs. Tools are left out."/>
                <Button x:Name="RemoveButton" Content="Remove kit" Style="{StaticResource Fk.Button}"
                        Margin="8,0,0,0" Click="Remove_Click"/>
                <CheckBox x:Name="ShortcutCheck" Content="Desktop shortcut" Margin="16,0,0,0"
                          VerticalAlignment="Center" IsChecked="True"
                          ToolTip="Adds a shortcut to the kit folder on the desktop for all users."/>
                <TextBlock x:Name="StatusText" Style="{StaticResource Fk.Secondary}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
