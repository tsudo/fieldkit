<UserControl x:Class="FieldKit.Pages.NetworkPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,10,8">
            <TextBlock Text="Network DNS" Style="{StaticResource Fk.PageTitle}"/>
            <TextBlock Text="Choose which resolver Windows uses on one adapter." Style="{StaticResource Fk.PageSubtitle}"/>
            <Border Style="{StaticResource Fk.Card}">
                <StackPanel>
                    <TextBlock Text="Network adapter" FontWeight="SemiBold"/>
                    <ComboBox x:Name="Adapters" Margin="0,5,0,6" SelectionChanged="AdapterChanged"/>
                    <TextBlock x:Name="CurrentText" TextWrapping="Wrap" Style="{StaticResource Fk.RowDetail}"/>
                    <TextBlock x:Name="ManagementText" TextWrapping="Wrap" Margin="0,5,0,0" Style="{StaticResource Fk.RowDetail}"/>
                    <CheckBox x:Name="ManagedConsent" Content="I am authorized to change DNS on this managed or VPN connection."
                              Visibility="Collapsed" Margin="0,6,0,0" Click="ConsentChanged"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Fk.Card}">
                <StackPanel>
                    <TextBlock Text="DNS provider" FontWeight="SemiBold"/>
                    <ComboBox x:Name="Providers" Margin="0,5,0,4" SelectedIndex="0" SelectionChanged="ProviderChanged">
                        <ComboBoxItem Content="Automatic (DHCP)"/>
                        <ComboBoxItem Content="Cloudflare — block malware"/>
                        <ComboBoxItem Content="NextDNS — use a profile"/>
                    </ComboBox>
                    <StackPanel x:Name="ProfilePanel" Visibility="Collapsed">
                        <TextBlock Text="NextDNS profile ID" Style="{StaticResource Fk.RowDetail}"/>
                        <DockPanel>
                            <Button Content="Open profile setup" DockPanel.Dock="Right" Margin="8,0,0,0"
                                    Style="{StaticResource Fk.Button}" Click="Setup_Click"/>
                            <TextBox x:Name="Profile" MaxLength="6" VerticalContentAlignment="Center"/>
                        </DockPanel>
                        <TextBlock Text="Verification sends a random FieldKit device label to your NextDNS profile." Style="{StaticResource Fk.RowDetail}"/>
                    </StackPanel>
                    <WrapPanel Margin="0,10,0,0">
                        <Button x:Name="Apply" Content="Apply and verify" Style="{StaticResource Fk.Button.Primary}" Click="Apply_Click" Margin="0,0,8,4"/>
                        <Button x:Name="Test" Content="Test current DNS" Style="{StaticResource Fk.Button}" Click="Test_Click" Margin="0,0,8,4"/>
                        <Button x:Name="Restore" Content="Restore previous settings" Style="{StaticResource Fk.Button}" Click="Restore_Click" Margin="0,0,8,4"/>
                        <Button x:Name="Refresh" Content="Refresh adapters" Style="{StaticResource Fk.Button}" Click="Refresh_Click" Margin="0,0,0,4"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
            <TextBlock x:Name="Status" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" Style="{StaticResource Fk.RowDetail}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
