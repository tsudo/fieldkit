<UserControl x:Class="FieldKit.Pages.StorageSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Storage Sense" Style="{StaticResource Fk.PageTitle}"/>
            <Border Style="{StaticResource Fk.Card}" Margin="0,12,0,10">
                <StackPanel>
                    <TextBlock x:Name="Account" FontWeight="SemiBold"/>
                    <TextBlock x:Name="State" Style="{StaticResource Fk.RowDetail}" TextWrapping="Wrap"/>
                    <TextBlock Text="Enable changes only the on/off setting. Your schedule, Downloads, cloud files and Recycle Bin preferences are preserved."
                               Style="{StaticResource Fk.RowDetail}" TextWrapping="Wrap" Margin="0,8"/>
                    <WrapPanel>
                        <Button x:Name="Enable" Content="Enable with existing settings" Style="{StaticResource Fk.Button.Primary}" Click="Enable_Click" Margin="0,0,8,4"/>
                        <Button x:Name="Undo" Content="Undo FieldKit change" Style="{StaticResource Fk.Button}" Click="Undo_Click" Margin="0,0,8,4"/>
                        <Button Content="Windows storage settings" Style="{StaticResource Fk.Button}" Click="Open_Click" Margin="0,0,0,4"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
            <TextBlock x:Name="Status" TextWrapping="Wrap" Style="{StaticResource Fk.Secondary}" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
