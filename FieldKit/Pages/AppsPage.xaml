<UserControl x:Class="FieldKit.Pages.AppsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Apps" Style="{StaticResource Fk.PageTitle}"/>
            <TextBlock Text="Install common software or update what's already here. Nothing installs until you confirm."
                       Style="{StaticResource Fk.PageSubtitle}"/>
        </StackPanel>

        <DockPanel Grid.Row="1">
            <TextBox x:Name="SearchBox" DockPanel.Dock="Right" Width="190" VerticalAlignment="Center"
                     ToolTip="Filter the list by name" TextChanged="Search_TextChanged"/>
            <TextBlock DockPanel.Dock="Right" Text="Filter" Style="{StaticResource Fk.Secondary}"
                       VerticalAlignment="Center" Margin="0,0,8,0"/>
            <StackPanel x:Name="BundleBar" Orientation="Horizontal"/>
        </DockPanel>

        <Border x:Name="Notice" Grid.Row="2" Style="{StaticResource Fk.Notice}" Margin="0,12,0,0"
                Visibility="Collapsed">
            <TextBlock x:Name="NoticeText" TextWrapping="Wrap" FontSize="12.5"/>
        </Border>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Focusable="False" Margin="0,2,0,0">
            <StackPanel Margin="0,0,10,0">
                <ItemsControl x:Name="GroupList" ItemTemplate="{StaticResource Fk.GroupTemplate}" Focusable="False"/>

                <TextBlock Text="Not installable from here" Style="{StaticResource Fk.GroupLabel}"/>
                <ItemsControl x:Name="LinkList" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Fk.Row}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Open page" Padding="10,3" MinHeight="26"
                                            FontSize="12" Style="{StaticResource Fk.Button}"
                                            Tag="{Binding Url}" Click="Link_Click"/>
                                    <StackPanel Margin="4,0,0,0">
                                        <TextBlock Text="{Binding Name}" FontSize="13.5"
                                                   Foreground="{StaticResource Fk.Text.Primary}"/>
                                        <TextBlock Text="{Binding Note}" Style="{StaticResource Fk.RowDetail}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="4" Style="{StaticResource Fk.ActionBar}">
            <DockPanel>
                <Button x:Name="ActionButton" Content="Install" Style="{StaticResource Fk.Button.Primary}"
                        MinWidth="130" Click="Action_Click"/>
                <Button x:Name="StopButton" Content="Stop" Style="{StaticResource Fk.Button}"
                        Margin="8,0,0,0" Visibility="Collapsed" Click="Stop_Click"/>
                <Button x:Name="RescanButton" Content="Scan again" Style="{StaticResource Fk.Button}"
                        Margin="8,0,0,0" Click="Rescan_Click"/>
                <Button x:Name="ClearButton" Content="Clear selection" Style="{StaticResource Fk.Button}"
                        Margin="8,0,0,0" Click="Clear_Click"/>
                <TextBlock x:Name="StatusText" Style="{StaticResource Fk.Secondary}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
