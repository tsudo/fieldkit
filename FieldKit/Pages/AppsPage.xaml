<UserControl x:Class="FieldKit.Pages.AppsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <DataTemplate x:Key="CatalogLinkTemplate">
            <Border Style="{StaticResource Fk.Row}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="{Binding Action}" Padding="10,3" MinHeight="26"
                            FontSize="12" Style="{StaticResource Fk.Button}"
                            Tag="{Binding Url}" Click="Link_Click"/>
                    <StackPanel Margin="4,0,0,0">
                        <TextBlock Text="{Binding Name}" FontSize="13.5"
                                   Foreground="{StaticResource Fk.Text.Primary}"/>
                        <TextBlock Text="{Binding Note}" Style="{StaticResource Fk.RowDetail}"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Install apps" Style="{StaticResource Fk.PageTitle}"/>
            <TextBlock Text="Choose software to install on this PC."
                       Style="{StaticResource Fk.PageSubtitle}"/>
        </StackPanel>

        <DockPanel Grid.Row="1" LastChildFill="False">
            <TextBox x:Name="SearchBox" DockPanel.Dock="Right" Width="190" VerticalAlignment="Center"
                     ToolTip="Filter the list by name" TextChanged="Search_TextChanged"/>
            <TextBlock DockPanel.Dock="Right" Text="Filter" Style="{StaticResource Fk.Secondary}"
                       VerticalAlignment="Center" Margin="0,0,8,0"/>
        </DockPanel>

        <Border x:Name="Notice" Grid.Row="2" Style="{StaticResource Fk.Notice}" Margin="0,12,0,0"
                Visibility="Collapsed">
            <TextBlock x:Name="NoticeText" TextWrapping="Wrap" FontSize="12.5"/>
        </Border>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Focusable="False" Margin="0,2,0,0">
            <StackPanel Margin="0,0,10,0">
                <TextBlock Text="Essentials" Style="{StaticResource Fk.GroupLabel}"/>
                <ItemsControl x:Name="EssentialsList" ItemTemplate="{StaticResource Fk.RowTemplate}"/>
                <ItemsControl x:Name="FeaturedLinks" Margin="0,6,0,4" ItemTemplate="{StaticResource CatalogLinkTemplate}"/>
                <TextBlock Text="Technician tools" Style="{StaticResource Fk.GroupLabel}"/>
                <ItemsControl x:Name="TechnicianList" ItemTemplate="{StaticResource Fk.RowTemplate}"/>
                <Expander x:Name="Picks" Header="Keith's picks" IsExpanded="False" Collapsed="Picks_Collapsed"
                          Margin="0,10,0,4" Foreground="{StaticResource Fk.Text.Primary}">
                    <StackPanel>
                        <ItemsControl x:Name="PicksList" ItemTemplate="{StaticResource Fk.GroupTemplate}"/>
                        <ItemsControl x:Name="LinkList" ItemTemplate="{StaticResource CatalogLinkTemplate}"/>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="4" Style="{StaticResource Fk.ActionBar}">
            <DockPanel>
                <Button x:Name="ActionButton" Content="Install" Style="{StaticResource Fk.Button.Primary}"
                        MinWidth="130" Click="Action_Click"/>
                <Button x:Name="StopButton" Content="Stop" Style="{StaticResource Fk.Button}"
                        Margin="8,0,0,0" Visibility="Collapsed" Click="Stop_Click"/>
                <Button x:Name="RescanButton" Content="Scan again" Style="{StaticResource Fk.Button}"
                        Margin="8,0,0,0" Click="Rescan_Click"/>
                <Button x:Name="ClearButton" Content="Clear selection" Style="{StaticResource Fk.Button}"
                        Margin="8,0,0,0" Click="Clear_Click"/>
                <TextBlock x:Name="StatusText" Style="{StaticResource Fk.Secondary}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
