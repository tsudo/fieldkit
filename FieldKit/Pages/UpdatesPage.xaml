<UserControl x:Class="FieldKit.Pages.UpdatesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <Button x:Name="CheckButton" DockPanel.Dock="Right" Content="Check for updates"
                    Style="{StaticResource Fk.Button}" Click="Check_Click"/>
            <StackPanel>
                <TextBlock Text="Updates" Style="{StaticResource Fk.PageTitle}"/>
                <TextBlock x:Name="LastCheckText" Style="{StaticResource Fk.Secondary}" Margin="0,3,0,0"/>
            </StackPanel>
        </DockPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel Margin="0,0,8,0">
                <UniformGrid Columns="2" Rows="1">
                    <Border Style="{StaticResource Fk.Card}" Margin="0,0,4,0">
                        <StackPanel>
                            <TextBlock Text="Windows Update" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock x:Name="WindowsStatus" Style="{StaticResource Fk.RowDetail}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Fk.Card}" Margin="4,0,0,0">
                        <StackPanel>
                            <TextBlock Text="App updates (winget)" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock x:Name="AppsStatus" Style="{StaticResource Fk.RowDetail}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>
                <TextBlock x:Name="RestartText" Style="{StaticResource Fk.Secondary}" Margin="2,6,0,0"/>
                <StackPanel x:Name="SelectionPanel" Visibility="Collapsed">
                    <TextBlock Text="Available updates" Style="{StaticResource Fk.GroupLabel}"/>
                    <CheckBox x:Name="IncludeWindows" Content="Include Windows updates"
                              Margin="4,4" Visibility="Collapsed"
                              Click="Selection_Click"/>
                    <ItemsControl x:Name="WindowsList" Margin="24,0,0,4">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" Style="{StaticResource Fk.Secondary}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl x:Name="AppList" ItemTemplate="{StaticResource Fk.RowTemplate}"/>
                </StackPanel>
                <Border Style="{StaticResource Fk.Card}" Margin="0,14,0,0">
                    <DockPanel>
                        <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                            <Button x:Name="RunLogButton" Content="Open log" Style="{StaticResource Fk.Button}"
                                    Margin="8,0,0,0" Click="OpenLog_Click"/>
                            <Button Content="Run history" Style="{StaticResource Fk.Button}"
                                    Margin="8,0,0,0" Click="History_Click"/>
                        </WrapPanel>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Last update run" FontWeight="SemiBold"/>
                            <TextBlock x:Name="LastRunText" Style="{StaticResource Fk.RowDetail}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Expander Header="More update options" Margin="0,10,0,0">
                    <WrapPanel x:Name="MoreActions" Margin="4,8,0,0">
                        <Button x:Name="OfficeButton" Content="Update Microsoft Office"
                                Style="{StaticResource Fk.Button}" Click="Extra_Click"/>
                        <Button x:Name="StoreButton" Content="Check Microsoft Store apps" Margin="8,0,0,0"
                                Style="{StaticResource Fk.Button}" Click="Extra_Click"/>
                    </WrapPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Style="{StaticResource Fk.ActionBar}">
            <StackPanel>
                <TextBlock x:Name="StatusText" Style="{StaticResource Fk.Secondary}" TextWrapping="Wrap"
                           Visibility="Collapsed" Margin="0,0,0,6"/>
                <WrapPanel>
                    <Button x:Name="AllButton" Content="Update all" Style="{StaticResource Fk.Button.Primary}"
                            Click="Apply_Click"/>
                    <Button x:Name="SelectedButton" Content="Update selected" Style="{StaticResource Fk.Button}"
                            Margin="8,0,0,0" Click="Apply_Click"/>
                    <Button x:Name="StopButton" Content="Stop" Style="{StaticResource Fk.Button}"
                            Margin="8,0,0,0" Click="Stop_Click" Visibility="Collapsed"/>
                </WrapPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
