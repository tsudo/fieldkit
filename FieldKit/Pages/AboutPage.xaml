<UserControl x:Class="FieldKit.Pages.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,10,8">
            <TextBlock Text="About FieldKit" Style="{StaticResource Fk.PageTitle}"/>
            <Border Style="{StaticResource Fk.Card}" Margin="0,12,0,8">
                <StackPanel>
                    <TextBlock x:Name="VersionText" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="By Keith S. Crawford" Style="{StaticResource Fk.RowDetail}"/>
                    <WrapPanel Margin="0,12,0,0">
                        <Button x:Name="CheckButton" Content="Check for FieldKit updates" Click="Check_Click"
                                Style="{StaticResource Fk.Button.Primary}" Margin="0,0,8,4"/>
                        <Button Content="Releases on GitHub" Click="Releases_Click" Style="{StaticResource Fk.Button}" Margin="0,0,8,4"/>
                        <Button Content="GitHub repository" Click="Repository_Click" Style="{StaticResource Fk.Button}" Margin="0,0,0,4"/>
                    </WrapPanel>
                    <TextBlock x:Name="StatusText" Style="{StaticResource Fk.RowDetail}" TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
            </Border>
            <Expander Header="Disclaimer" Margin="0,4">
                <TextBlock x:Name="DisclaimerText" TextWrapping="Wrap" Margin="12" Style="{StaticResource Fk.Secondary}"/>
            </Expander>
            <Expander Header="MIT License" Margin="0,4">
                <TextBlock x:Name="LicenseText" TextWrapping="Wrap" Margin="12" Style="{StaticResource Fk.Secondary}"/>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
