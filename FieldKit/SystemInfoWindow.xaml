<Window x:Class="FieldKit.SystemInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="System Information — FieldKit"
        Width="680" Height="600"
        MinWidth="500" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Icon="fieldkit.ico"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBox x:Name="ReportBox" Grid.Row="0"
                 IsReadOnly="True" TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 BorderThickness="0"
                 FontFamily="Cascadia Mono, Consolas" FontSize="12"
                 Padding="16,12" Margin="0"/>

        <Border Grid.Row="1" Padding="12,8"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Export to File" Padding="16,6" Margin="0,0,8,0"
                        Click="Export_Click"
                        Background="#3782E1" Foreground="White"/>
                <Button Content="Close" Padding="16,6"
                        Click="Close_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
