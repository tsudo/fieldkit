<Window x:Class="FieldKit.DisclaimerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FieldKit — License Agreement"
        Width="540" Height="460"
        MinWidth="440" MinHeight="360"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Icon="fieldkit.ico"
        Background="{StaticResource Fk.Bg.Window}">

    <Grid Margin="24,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="VersionTitle" Grid.Row="0" Text="FieldKit"
                   Foreground="{StaticResource Fk.Text.Primary}"
                   FontSize="16" FontWeight="SemiBold"
                   Margin="0,0,0,12"/>

        <TextBox Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 BorderThickness="0"
                 Background="Transparent"
                 FontSize="13" Padding="4"
                 Foreground="{StaticResource Fk.Text.Secondary}"
                 x:Name="DisclaimerText"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="Decline" MinWidth="90" Style="{StaticResource Fk.Button}"
                    Margin="0,0,8,0" Click="Decline_Click"/>
            <Button Content="Agree" MinWidth="90" Style="{StaticResource Fk.Button.Primary}"
                    Click="Agree_Click"/>
        </StackPanel>
    </Grid>
</Window>
