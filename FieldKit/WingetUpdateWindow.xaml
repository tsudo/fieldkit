<Window x:Class="FieldKit.WingetUpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Available App Updates"
        Width="900" Height="520"
        MinWidth="720" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Icon="fieldkit.ico"
        Background="#1F232E">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Available App Updates"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="#F4F7FB"/>
            <TextBlock x:Name="SummaryText"
                       Margin="0,4,0,0"
                       Foreground="#B6C0D0"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <DataGrid x:Name="UpdatesGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="False"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  BorderThickness="1"
                  BorderBrush="#3F485A"
                  Background="#20242F"
                  Foreground="#F0F3F7"
                  RowBackground="#252A36"
                  AlternatingRowBackground="#20242F"
                  HorizontalGridLinesBrush="#3F485A"
                  SelectionMode="Extended"
                  VerticalScrollBarVisibility="Auto">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#2D3442"/>
                    <Setter Property="Foreground" Value="#F4F7FB"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Padding" Value="8,7"/>
                    <Setter Property="BorderBrush" Value="#3F485A"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="MinHeight" Value="30"/>
                    <Setter Property="Foreground" Value="#F0F3F7"/>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="Padding" Value="8,4"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#315E92"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.CellStyle>
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Header="" Width="44"/>
                <DataGridTextColumn Binding="{Binding Name}" Header="App" Width="2*" IsReadOnly="True"/>
                <DataGridTextColumn Binding="{Binding Id}" Header="Package ID" Width="2*" IsReadOnly="True"/>
                <DataGridTextColumn Binding="{Binding InstalledVersion}" Header="Installed" Width="*" IsReadOnly="True"/>
                <DataGridTextColumn Binding="{Binding AvailableVersion}" Header="Available" Width="*" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button Content="Select All" Padding="12,6" Margin="0,0,8,0" Click="SelectAll_Click"/>
                <Button Content="Select None" Padding="12,6" Click="SelectNone_Click"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Scan Only" Padding="14,6" Margin="0,0,8,0" Click="ScanOnly_Click"/>
                <Button Content="Install Selected" Padding="14,6" Margin="0,0,8,0"
                        Background="#3782E1" Foreground="White" Click="InstallSelected_Click"/>
                <Button Content="Cancel" Padding="14,6" Click="Cancel_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
